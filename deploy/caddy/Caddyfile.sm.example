{
	admin 127.0.0.1:2019
}

http://scjrdomain.com:8800 {
	redir https://scjrdomain.com:4430{uri} permanent
}

https://scjrdomain.com:4430 {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
	}

	@internal_only path /docs /openapi.json
	handle @internal_only {
		respond 404
	}

	handle {
		reverse_proxy 127.0.0.1:18800
	}
}
