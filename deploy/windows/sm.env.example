# Runtime metadata is generated under SM_DATA_DIR after a successful startup:
#   deployment.json and data_manifest.json
# Do not copy Caddy runtime state or this example into a production data backup.
SERVER_HOST=127.0.0.1
SERVER_PORT=18800
SM_PUBLIC_HTTP_PORT=8800
SM_PUBLIC_HTTPS_PORT=4430
SM_ENVIRONMENT=production
SM_DATA_DIR=./data
SERVER_MANAGER_DB_PATH=./data/server_manager.db
SM_SOFTWARE_STORAGE_DIR=./data/software
SM_PUBLIC_BASE_URL=https://scjrdomain.com:4430
SM_ALLOWED_HOSTS=scjrdomain.com,127.0.0.1,localhost
SM_CORS_ORIGINS=https://scjrdomain.com:4430
SM_COOKIE_SECURE=1
SM_DOMAIN_POOL_REQUIRED=1
SM_DOMAIN_COOLDOWN_SECONDS=1800
SM_DNSPOD_MODE=real
SM_DNSPOD_SECRET_ID=
SM_DNSPOD_SECRET_KEY=
SM_CADDY_AUTO_MANAGE=1
SM_CADDY_REQUIRED=1
SM_CADDY_EXE=./caddy/caddy.exe
SM_CADDY_DIR=./caddy
SM_CADDY_ADMIN=127.0.0.1:2019
# Set both absolute paths when public 80/443 are unavailable and no reusable Caddy certificate exists.
SM_CADDY_CERT_FILE=
SM_CADDY_KEY_FILE=
SM_CADDY_START_TIMEOUT=10
CLIENT_TOKEN_TTL_SECONDS=86400
SM_BOOTSTRAP_ADMIN_USERNAME=admin
SM_BOOTSTRAP_ADMIN_PASSWORD=
SM_FINANCE_ENABLED=1
SM_FINANCE_RETENTION_MONTHS=3
SM_FINANCE_CLEANUP_INTERVAL_SECONDS=21600
